---
/** RTINGS-style "Notable Mentions": strong models that missed the list, and when they're the better buy. */
import { getProduct, productUrl } from '../lib/data';
import { md } from '../lib/md';
import Score from './Score.astro';
import ProductImage from './ProductImage.astro';
interface Props { items: { product: string; body: string }[] }
const rows = Astro.props.items.map((m) => ({ p: getProduct(m.product), body: m.body }));
---
<ul class="not-prose mt-4 divide-y divide-slate-200 border-y border-slate-200">
  {rows.map(({ p, body }) => (
    <li class="py-5 flex gap-4">
      <ProductImage product={p} size={160} class="w-16 h-16 shrink-0 rounded-lg" />
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-ink text-lg leading-snug"><a href={productUrl(p)} class="hover:text-brand-600 underline decoration-slate-300 underline-offset-2">{p.name}</a></h3>
        <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-600"><Score score={p.score} /><span>{p.priceBand}</span></p>
        <div class="prose mt-2 !text-[1rem]" set:html={md(body)} />
      </div>
    </li>
  ))}
</ul>
