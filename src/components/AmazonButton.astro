---
import type { Product } from '../lib/types';
import { amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { product: Product; label?: string; small?: boolean }
const { product, label = 'Check Price on Amazon', small } = Astro.props;
---
<a class={`buy${small ? ' buy-sm' : ''}`} href={amazonUrl(product)} rel={AFFILIATE_REL} target="_blank" data-asin={product.asin ?? ''} data-product={product.slug}>{label}</a>
