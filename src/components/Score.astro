---
import { SITE } from '../data/site';
interface Props { score: number; size?: 'sm' | 'lg' }
const { score, size = 'sm' } = Astro.props;
const tier = score >= 88 ? 'top' : score >= 80 ? 'good' : score >= 72 ? 'ok' : 'low';
---
<span class={`score score-${size} score-${tier}`} title={`${SITE.score}: our research score out of 100`}><b>{score}</b><small>/100</small></span>
