---
interface Props { score: number; size?: 'sm' | 'lg' }
const { score, size = 'sm' } = Astro.props;
const color = score >= 85 ? 'bg-emerald-600' : score >= 75 ? 'bg-brand-600' : score >= 65 ? 'bg-amber-500' : 'bg-slate-500';
---
<span class={`inline-flex items-center gap-1 rounded-lg text-white font-bold ${color} ${size === 'lg' ? 'px-3 py-1.5 text-lg' : 'px-2 py-0.5 text-xs'}`} title="BHTR Score out of 100">
  {score}<span class="font-medium opacity-80 text-[0.75em]">/100</span>
</span>
