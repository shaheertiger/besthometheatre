---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { h1: string; intro?: string; crumbs: { name: string; url: string }[]; eyebrow?: string }
const { h1, intro, crumbs, eyebrow } = Astro.props;
---
<Breadcrumbs items={crumbs} />
{eyebrow && <p class="kicker">{eyebrow}</p>}
<h1 class="hub-title">{h1}</h1>
{intro && <p class="hub-dek" set:html={intro} />}
