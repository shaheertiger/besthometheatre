---
import type { Article } from '../lib/types';
import { articleUrl, hubLabel, getProduct } from '../lib/data';
import ProductImage from './ProductImage.astro';
import Icon from './Icon.astro';
interface Props { articles: Article[]; images?: boolean }
const { articles, images = true } = Astro.props;
---
<div class="grid grid-3">
  {articles.map((a) => {
    const top = a.picks?.[0] ? getProduct(a.picks[0].product) : undefined;
    return (
      <a class="card" href={articleUrl(a)}>
        {images && (top ? <ProductImage product={top} size={72} /> : <Icon icon={a.hub} size={44} />)}
        <span class="card-k">{a.kind === 'review' ? 'Brand Review' : a.kind === 'guide' ? 'Guide' : hubLabel(a.hub)}</span>
        <h3>{a.h1}</h3>
        <span class="card-sub">{a.metaDescription}</span>
        {top && a.kind !== 'guide' && <span class="card-sub">Top pick: {top.name}</span>}
      </a>
    );
  })}
</div>
