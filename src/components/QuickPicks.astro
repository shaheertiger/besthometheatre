---
// The shortlist under the intro: numbered picks, the award, who each suits, score, price and an Amazon link.
import type { Pick } from '../lib/types';
import { getProduct } from '../lib/data';
import { amazonUrl, AFFILIATE_REL } from '../lib/amazon';
import ProductImage from './ProductImage.astro';
import Score from './Score.astro';
interface Props { picks: Pick[] }
const { picks } = Astro.props;
---
<section class="shortlist" id="quick-picks" aria-label="Shortlist">
  <p class="mini">Shortlist: which pick suits you</p>
  <ol>
    {picks.map((pk, i) => {
      const p = getProduct(pk.product);
      return (
        <li class={p.imageId ? 'has-thumb' : undefined}>
          <span class="sl-n">{i + 1}</span>
          {p.imageId && <ProductImage product={p} size={52} class="sl-thumb" eager={i < 3} />}
          <div class="sl-main">
            <div class="sl-label">{pk.award}</div>
            <a class="sl-name" href={`#pick-${i + 1}`}>{p.name}</a>
            <div class="sl-for">{p.bestFor}</div>
          </div>
          <div class="sl-side"><Score score={p.score} /><span class="sl-price">{p.priceBand}</span><a class="sl-view" href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">View</a></div>
        </li>
      );
    })}
  </ol>
</section>
