---
/** RTINGS "All Reviews" equivalent: every model we track in the category, ranked by BHTR Score. */
import type { Product } from '../lib/types';
import { productUrl } from '../lib/data';
interface Props { products: Product[]; picked: string[]; label: string }
const { products, picked, label } = Astro.props;
---
<div class="not-prose my-6 overflow-x-auto rounded-xl border border-slate-200" role="region" aria-label={label} tabindex="0">
  <table class="min-w-[560px] w-full text-sm">
    <caption class="sr-only">{label}</caption>
    <thead class="bg-slate-50 text-left text-slate-700">
      <tr>
        <th scope="col" class="px-3 py-2.5 font-semibold w-10">#</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Model</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Score</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Price</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Best for</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 align-top">
      {products.map((p, i) => (
        <tr class={picked.includes(p.slug) ? 'bg-amber-50/50' : ''}>
          <td class="px-3 py-2.5 text-slate-500">{i + 1}</td>
          <th scope="row" class="px-3 py-2.5 text-left font-normal">
            <a href={productUrl(p)} class="font-semibold text-ink hover:text-brand-600 underline decoration-slate-300 underline-offset-2">{p.name}</a>
            {picked.includes(p.slug) && <span class="ml-1.5 text-[11px] font-bold uppercase tracking-wide text-gold-dark">On this list</span>}
          </th>
          <td class="px-3 py-2.5 font-bold">{p.score}</td>
          <td class="px-3 py-2.5 whitespace-nowrap text-slate-700">{p.priceBand}</td>
          <td class="px-3 py-2.5 text-slate-700">{p.bestFor}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
