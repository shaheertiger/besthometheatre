---
interface Props { pros: string[]; cons: string[]; level?: 'h3' | 'h4' }
const { pros, cons, level = 'h4' } = Astro.props;
const H = level;
---
<div class="proscons">
  <div class="pros"><H>Pros</H><ul>{pros.map((t) => <li>{t}</li>)}</ul></div>
  <div class="cons"><H>Cons</H><ul>{cons.map((t) => <li>{t}</li>)}</ul></div>
</div>
