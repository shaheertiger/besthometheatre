---
import { articleMap, articleUrl } from '../lib/data';
import { FORMAT } from '../data/site';
import type { Article } from '../lib/types';
interface Props { slug: string }
const { slug } = Astro.props;
const items = FORMAT.alsoNeeded.filter((s) => s !== slug).map((s) => articleMap.get(s)).filter((a): a is Article => !!a && !a.draft).slice(0, 3);
---
{items.length > 0 && (
  <section id="before-you-buy" class="not-prose my-12 scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="text-2xl font-extrabold text-ink">Before You Buy</h2>
    <p class="mt-4 text-xs font-extrabold uppercase tracking-widest text-gold-dark">{FORMAT.alsoNeededLabel}</p>
    <ul class="mt-3 space-y-2">{items.map((a) => <li><a href={articleUrl(a)} class="text-brand-600 font-semibold hover:text-brand-700">{a.title}</a></li>)}</ul>
  </section>
)}
