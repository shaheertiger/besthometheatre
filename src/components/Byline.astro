---
import { SITE } from '../data/site';
import { AUTHOR, authorUrl } from '../data/authors';
import { formatDate } from '../lib/data';
interface Props { updated: string; published?: string; minutes?: number; disclosure?: boolean }
const { updated, published, minutes, disclosure = true } = Astro.props;
---
<div class="byline">
  By <a href={authorUrl}>{AUTHOR.name}</a> · Updated <time datetime={updated}>{formatDate(updated)}</time>{minutes && <> · {minutes} min read</>}
  {published && published !== updated && <> · First published <time datetime={published}>{formatDate(published)}</time></>}
</div>
{disclosure && (
  <p class="disclosure">
    These picks are researched against spec sheets, published independent measurements and owner reports, then checked against room maths. When you buy through our links we may earn a commission, at no cost to you. <a href="/how-we-test/">How the {SITE.score} works</a> · <a href="/affiliate-disclosure/">Disclosure</a>
  </p>
)}
