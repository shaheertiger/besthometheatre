---
import { AUTHOR } from '../data/site';
import { formatDate } from '../lib/data';
interface Props { updated: string; published?: string; minutes?: number }
const { updated, published, minutes } = Astro.props;
---
<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
  <span>By <a href={AUTHOR.url} rel="author" class="font-semibold text-slate-700 hover:text-brand-600 underline decoration-slate-300 underline-offset-2">{AUTHOR.name}</a></span>
  <span aria-hidden="true">·</span>
  <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>
  {minutes && <><span aria-hidden="true">·</span><span>{minutes} min read</span></>}
  {published && published !== updated && <span class="basis-full sm:basis-auto">First published <time datetime={published}>{formatDate(published)}</time></span>}
</div>
