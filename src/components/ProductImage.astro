---
// The product's Amazon photo, or the category icon when we hold no verified listing. Links to Amazon when `buy` is set.
import type { Product } from '../lib/types';
import Icon from './Icon.astro';
import { amazonImage, amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { product: Product; size?: number; buy?: boolean; eager?: boolean; class?: string }
const { product: p, size = 64, buy = false, eager = false, class: cls } = Astro.props;
const src = amazonImage(p, size > 200 ? 500 : size > 80 ? 300 : 160);
const c = `p-img${cls ? ` ${cls}` : ''}`;
const style = `width:${size}px;height:${size}px`;
---
{src ? (
  buy ? (
    <a class={c} style={style} href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank"><img src={src} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer-when-downgrade" /></a>
  ) : (
    <span class={c} style={style}><img src={src} alt={p.name} width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer-when-downgrade" /></span>
  )
) : (
  <Icon icon={p.category} size={size} label={p.name} />
)}
