---
// Sticky Amazon bar at the foot of the article (the enthusiastreview.com pattern).
// mode "single": one product with photo and score; "pair": two buttons (comparisons, phones only).
import { AFFILIATE_REL } from '../lib/amazon';
interface Item { slug: string; name: string; label?: string; url: string; image: string | null }
interface Props { items: Item[]; mode?: 'single' | 'pair'; mobileOnly?: boolean }
const { items, mode = 'single', mobileOnly = false } = Astro.props;
const it = items[0];
---
{items.length > 0 && (mode === 'pair' ? (
  <div class="sticky-buy sb-mobile sb-pair" aria-label="Check prices on Amazon">
    {items.map((x) => <a class="buy buy-sm" href={x.url} rel={AFFILIATE_REL} target="_blank" data-product={x.slug}>{x.name}</a>)}
    <button class="sb-close" type="button" aria-label="Dismiss" onclick="this.parentElement.hidden=true">×</button>
  </div>
) : (
  <div class={`sticky-buy${mobileOnly ? ' sb-mobile' : ''}`} aria-label="Top pick">
    {it.image && <span class="p-img" style="width:40px;height:40px"><img src={it.image} alt="" width="40" height="40" loading="lazy" decoding="async" /></span>}
    <span class="sb-text">{it.label && <span class="sb-k">{it.label}</span>}<strong>{it.name}</strong></span>
    <a class="buy buy-sm" href={it.url} rel={AFFILIATE_REL} target="_blank" data-product={it.slug}>Check Price</a>
    <button class="sb-close" type="button" aria-label="Dismiss" onclick="this.parentElement.hidden=true">×</button>
  </div>
))}
