---
import type { Product } from '../lib/types';
import { productUrl, shortName } from '../lib/data';
import { amazonUrl, AFFILIATE_REL } from '../lib/amazon';
interface Props { products: Product[]; specs: string[]; caption?: string }
const { products, specs, caption = "Key specs for every pick, from the manufacturers' spec sheets" } = Astro.props;
---
<div class="table-wrap">
  <table class="spec-table">
    <caption>{caption}</caption>
    <thead><tr><th>Model</th>{specs.map((s) => <th>{s}</th>)}<th>Score</th><th>Price</th><th>Buy</th></tr></thead>
    <tbody>
      {products.map((p) => (
        <tr>
          <td><a href={productUrl(p)}>{shortName(p.name)}</a></td>
          {specs.map((s) => <td>{p.specs[s] ?? '—'}</td>)}
          <td>{p.score}</td>
          <td class="nowrap">{p.priceBand}</td>
          <td class="nowrap"><a class="cell-link" href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">Amazon →</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
