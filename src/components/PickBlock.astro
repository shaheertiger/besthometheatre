---
import type { Pick } from '../lib/types';
import { getProduct, productUrl } from '../lib/data';
import { md } from '../lib/md';
import ProductImage from './ProductImage.astro';
import AmazonButton from './AmazonButton.astro';
import Score from './Score.astro';
import ProsCons from './ProsCons.astro';
interface Props { pick: Pick; index: number }
const { pick, index } = Astro.props;
const p = getProduct(pick.product);
const keys = (p.keySpecs?.length ? p.keySpecs : Object.keys(p.specs)).filter((k) => p.specs[k]).slice(0, 4);
---
<section class="pick" id={`pick-${index}`}>
  <div class="pick-head">
    <ProductImage product={p} size={96} buy eager={index === 1} />
    <div>
      <div class="pick-label">{pick.award}</div>
      <h3>{index}. {p.name}</h3>
      <div class="pick-meta">{p.priceBand} · Best for: {p.bestFor}</div>
    </div>
    <Score score={p.score} size="lg" />
  </div>
  <dl class="keyspecs">{keys.map((k) => <div><dt>{k}</dt><dd>{p.specs[k]}</dd></div>)}</dl>
  <p class="skip-if"><strong>Skip it if:</strong> {p.skipIf}</p>
  <div class="pick-cta"><AmazonButton product={p} /><a class="more" href={productUrl(p)}>Full specs &amp; score →</a></div>
  <div class="body" set:html={md(pick.body)} />
  <ProsCons pros={pick.pros ?? p.pros} cons={pick.cons ?? p.cons} />
</section>
