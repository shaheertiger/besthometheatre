---
/**
 * Up-front comparison table (master format step 5): what each pick is for, the limitation
 * most likely to change the decision, score and price band. Scrolls inside its own container.
 */
import type { Pick } from '../lib/types';
import { getProduct, productUrl } from '../lib/data';
import Score from './Score.astro';
interface Props { picks: Pick[]; label: string }
const { picks, label } = Astro.props;
const rows = picks.map((pk, i) => ({ pk, p: getProduct(pk.product), i: i + 1 }));
---
<div class="not-prose my-6 overflow-x-auto rounded-xl border border-slate-200 focus-visible:outline-2 focus-visible:outline-brand-600" role="region" aria-label={label} tabindex="0">
  <table class="min-w-[720px] w-full text-sm">
    <caption class="sr-only">{label}</caption>
    <thead class="bg-slate-50 text-left text-slate-700">
      <tr>
        <th scope="col" class="px-3 py-2.5 font-semibold w-[28%]">Pick</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Best for</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Skip it if</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Score</th>
        <th scope="col" class="px-3 py-2.5 font-semibold">Price</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 align-top">
      {rows.map(({ pk, p, i }) => (
        <tr>
          <th scope="row" class="px-3 py-3 text-left font-normal">
            <span class="block text-[11px] font-bold uppercase tracking-wide text-gold-dark">{pk.award}</span>
            <a href={`#pick-${i}`} class="font-semibold text-ink hover:text-brand-600 underline decoration-slate-300 underline-offset-2">{p.name}</a>
          </th>
          <td class="px-3 py-3 text-slate-700">{p.bestFor}</td>
          <td class="px-3 py-3 text-slate-700">{p.skipIf}</td>
          <td class="px-3 py-3"><Score score={p.score} /></td>
          <td class="px-3 py-3 whitespace-nowrap text-slate-700">{p.priceBand}<a href={productUrl(p)} class="block text-xs text-brand-600 hover:text-brand-700 mt-1">Specs</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
