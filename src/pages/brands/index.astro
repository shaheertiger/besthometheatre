---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { brands, productsByBrand, brandUrl, articles, articleUrl } from '../../lib/data';
import { CATEGORY_LABELS, SITE } from '../../data/site';
import { breadcrumbs, graph, itemList } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Brands', url: '/brands/' }];
const rows = brands.map((b) => { const ps = productsByBrand(b); return { b, ps, count: ps.length, avg: Math.round(ps.reduce((s, p) => s + p.score, 0) / ps.length), cats: [...new Set(ps.map((p) => CATEGORY_LABELS[p.category]))].join(', '), review: articles.find((a) => a.brand === b) }; }).sort((x, y) => y.count - x.count || y.avg - x.avg);
---
<Base title={`Home Theater Brands: ${brands.length} Brands Rated by Product Score`} description={`All ${brands.length} home theater brands we track: Sony, Klipsch, Polk, Denon, Epson, SVS, Sonos, Bose and more, with each lineup, its average ${SITE.score} and the best model.`} schema={graph(breadcrumbs(crumbs), itemList(rows.map((r) => ({ name: r.b, url: brandUrl(r.b) }))))} mdAlternate="/brands.md">
  <div class="wrap hub">
    <PageHeader h1="Home Theater Brands" crumbs={crumbs} intro="Who makes what, how their products score, and where to start with each brand." />
    <div class="brand-grid">
      {rows.map((r) => (
        <div class="brand-card">
          <h2><a href={brandUrl(r.b)}>{r.b}</a></h2>
          <p>{r.count} product{r.count > 1 ? 's' : ''} · average {SITE.score} {r.avg}</p>
          <p class="fine">{r.cats}</p>
          <p class="fine">Best: {r.ps[0].name} ({r.ps[0].score}/100){r.review && <> · <a href={articleUrl(r.review)}>Brand review</a></>}</p>
        </div>
      ))}
    </div>
  </div>
</Base>
