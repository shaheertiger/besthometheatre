---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductImage from '../../components/ProductImage.astro';
import Score from '../../components/Score.astro';
import { brands, productsByBrand, brandSlug, productUrl, articles, articleUrl, productMap, compareSlug, shortName } from '../../lib/data';
import { compares } from '../../data/compares';
import { CATEGORY_LABELS, SITE } from '../../data/site';
import { amazonUrl, AFFILIATE_REL } from '../../lib/amazon';
import { breadcrumbs, graph, itemList } from '../../lib/schema';
export function getStaticPaths() { return brands.map((b) => ({ params: { brand: brandSlug(b) }, props: { brand: b } })); }
const { brand } = Astro.props as { brand: string };
const ps = productsByBrand(brand);
const best = ps[0];
const review = articles.find((a) => a.brand === brand);
const featuredIn = articles.filter((a) => a.picks?.some((pk) => ps.some((p) => p.slug === pk.product)) && a.slug !== review?.slug);
const slugs = new Set(ps.map((p) => p.slug));
const pairs = compares.filter(([x, y]) => (slugs.has(x) || slugs.has(y)) && productMap.has(x) && productMap.has(y));
const cats = [...new Set(ps.map((p) => CATEGORY_LABELS[p.category].toLowerCase()))];
const url = `/brands/${brandSlug(brand)}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Brands', url: '/brands/' }, { name: brand, url }];
const avg = Math.round(ps.reduce((s, p) => s + p.score, 0) / ps.length);
const title = [`${brand} Review: ${ps.length} ${brand} Products Rated (2026)`, `${brand} Home Theater: ${ps.length} Products Rated`, `${brand}: ${ps.length} Products Rated`].find((t) => t.length <= 62) ?? `${brand} Products Rated`;
const desc = `${best.name} is the best-scoring ${brand} product we track at ${best.score}/100. See all ${ps.length} ${brand} ${cats.join(', ')} with specs, scores and prices.`;
---
<Base title={title} description={desc.length > 150 ? desc.slice(0, desc.lastIndexOf(' ', 148)).replace(/[,;:]$/, '') + '.' : desc} schema={graph(breadcrumbs(crumbs), { '@type': 'Brand', name: brand, url: `${SITE.url}${url}` }, itemList(ps.map((p) => ({ name: p.name, url: productUrl(p), product: p })), `${brand} products`))} mdAlternate={`/brands/${brandSlug(brand)}.md`}>
  <div class="col hub">
    <PageHeader h1={brand} crumbs={crumbs} intro={`We track ${ps.length} ${brand} product${ps.length > 1 ? 's' : ''} with an average ${SITE.score} of ${avg}/100. The highest-rated ${brand} model is the <a href="${productUrl(best)}">${best.name}</a> (${best.score}/100).`} />
    {review && <p class="answer-box">Read our full brand review: <a href={articleUrl(review)}>{review.h1}</a>.</p>}
    <h2 class="section-title">Every {brand} Product We Track</h2>
    <div class="table-wrap">
      <table class="tracked">
        <thead><tr><th>Product</th><th>Category</th><th>Score</th><th>Price</th><th></th></tr></thead>
        <tbody>{ps.map((p) => <tr><td class="with-thumb"><ProductImage product={p} size={40} /><a href={productUrl(p)}>{p.name}</a></td><td>{CATEGORY_LABELS[p.category]}</td><td>{p.score}</td><td class="nowrap">{p.priceBand}</td><td><a href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">Price</a></td></tr>)}</tbody>
      </table>
    </div>
    <div class="body">
      {ps.map((p) => (
        <div class="mention has-thumb">
          <ProductImage product={p} size={72} />
          <div class="mention-main">
            <h3><a href={productUrl(p)}>{p.name}</a></h3>
            <p class="mention-meta"><Score score={p.score} /> · {p.priceBand} · {CATEGORY_LABELS[p.category]}</p>
            <p>{p.summary}</p>
          </div>
        </div>
      ))}
    </div>
    {pairs.length > 0 && (<><h2 class="section-title">{brand} Comparisons</h2><ul class="link-list">{pairs.map(([x, y]) => <li><a href={`/compare/${compareSlug(x, y)}/`}>{shortName(productMap.get(x)!.name)} vs {shortName(productMap.get(y)!.name)}</a></li>)}</ul></>)}
    {featuredIn.length > 0 && (<><h2 class="section-title">{brand} in Our Best Lists</h2><ul class="link-list">{featuredIn.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a></li>)}</ul></>)}
  </div>
</Base>
