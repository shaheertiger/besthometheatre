---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RelatedCards from '../components/RelatedCards.astro';
import { articles } from '../lib/data';
import { glossary } from '../data/glossary';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const items = articles.filter((a) => a.kind === 'guide');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }];
---
<Base title="Home Theater Guides: Setup, Room Design & Buying Advice" description="Plain-English home theater guides: setup and speaker placement, room design, soundbar vs surround sound, and the demo movies that show what your system can do." schema={graph(breadcrumbs(crumbs), itemList(items.map((a) => ({ name: a.h1, url: `/${a.slug}/` }))))}>
  <PageHeader h1="Home Theater Guides" crumbs={crumbs} eyebrow="Guides" intro="Plan the room, place the speakers, calibrate, then enjoy. Start here if you're building your first system." />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <RelatedCards articles={items} />
    <section class="mt-12"><h2 class="text-xl font-extrabold text-ink">Tools</h2>
      <div class="mt-4 grid sm:grid-cols-2 gap-4">
        <a href="/tools/projector-throw-calculator/" class="block rounded-xl border border-slate-200 p-4 hover:border-brand-500 no-underline"><p class="font-bold text-ink">📐 Projector Throw Distance Calculator</p><p class="text-sm text-slate-500 mt-1">How far the projector goes for your screen size.</p></a>
        <a href="/tools/viewing-distance-calculator/" class="block rounded-xl border border-slate-200 p-4 hover:border-brand-500 no-underline"><p class="font-bold text-ink">📏 Viewing Distance &amp; Screen Size Calculator</p><p class="text-sm text-slate-500 mt-1">The right screen size for your seat.</p></a>
      </div>
    </section>
    <section class="mt-12"><h2 class="text-xl font-extrabold text-ink">Glossary</h2>
      <p class="mt-2 flex flex-wrap gap-2">{glossary.map((g) => <a href={`/glossary/${g.slug}/`} class="text-sm rounded-full border border-slate-200 px-3 py-1 hover:border-brand-500 no-underline text-slate-700">{g.term}</a>)}</p>
    </section>
  </div>
</Base>
