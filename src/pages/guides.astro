---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RelatedCards from '../components/RelatedCards.astro';
import Icon from '../components/Icon.astro';
import { articles } from '../lib/data';
import { glossary } from '../data/glossary';
import { breadcrumbs, graph, itemList } from '../lib/schema';
const items = articles.filter((a) => a.kind === 'guide');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }];
---
<Base title="Home Theater Guides: Setup, Room Design and Buying Advice" description="Plain-English home theater guides: setup and speaker placement, room design, soundbar vs surround sound, and the demo movies that show what a system can do." schema={graph(breadcrumbs(crumbs), itemList(items.map((a) => ({ name: a.h1, url: `/${a.slug}/` }))))} mdAlternate="/guides.md">
  <div class="wrap hub">
    <PageHeader h1="Home Theater Guides" crumbs={crumbs} intro="Plan the room, place the speakers, calibrate, then enjoy. Start here if you're building your first system." />
    <RelatedCards articles={items} />
    <h2 class="section-title">Tools</h2>
    <div class="grid grid-2">
      <a class="card" href="/tools/projector-throw-calculator/"><Icon icon="ruler" size={44} /><span class="card-k">Tool</span><h3>Projector Throw Distance Calculator</h3><span class="card-sub">How far the projector goes for your screen size.</span></a>
      <a class="card" href="/tools/viewing-distance-calculator/"><Icon icon="ruler" size={44} /><span class="card-k">Tool</span><h3>Viewing Distance and Screen Size Calculator</h3><span class="card-sub">The right screen size for your seat.</span></a>
    </div>
    <h2 class="section-title">Glossary</h2>
    <div class="chips">{glossary.map((g) => <a href={`/glossary/${g.slug}/`}>{g.term}</a>)}</div>
  </div>
</Base>
