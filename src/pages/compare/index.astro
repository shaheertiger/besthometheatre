---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { productMap, compareSlug, shortName } from '../../lib/data';
import { compares } from '../../data/compares';
import { CATEGORY_LABELS } from '../../data/site';
import { breadcrumbs, graph, itemList } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Comparisons', url: '/compare/' }];
const valid = compares.filter(([a, b]) => productMap.has(a) && productMap.has(b)).map(([a, b]) => ({ a: productMap.get(a)!, b: productMap.get(b)!, slug: compareSlug(a, b) }));
const cats = [...new Set(valid.map((v) => v.a.category))];
---
<Base title={`Compare Home Theater Gear: ${valid.length} Head-to-Head Comparisons`} description={`${valid.length} head-to-head comparisons of popular projectors, AV receivers, subwoofers, soundbars, speakers and TVs, with spec sheets side by side and a clear pick.`} schema={graph(breadcrumbs(crumbs), itemList(valid.map((v) => ({ name: `${v.a.name} vs ${v.b.name}`, url: `/compare/${v.slug}/` }))))} mdAlternate="/compare.md">
  <div class="wrap hub">
    <PageHeader h1="Compare Two Products" crumbs={crumbs} intro="The matchups people search for most, with spec sheets side by side and a clear answer on which to buy." />
    {cats.map((c) => (
      <section id={c}>
        <h2 class="section-title"><Icon icon={c} size={34} /> {CATEGORY_LABELS[c]}</h2>
        <ul class="vs-list">{valid.filter((v) => v.a.category === c).map((v) => <li><a href={`/compare/${v.slug}/`}>{shortName(v.a.name)} vs {shortName(v.b.name)}</a><span>{v.a.score} vs {v.b.score}</span></li>)}</ul>
      </section>
    ))}
  </div>
</Base>
