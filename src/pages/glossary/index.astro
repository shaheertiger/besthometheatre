---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { glossary } from '../../data/glossary';
import { SITE } from '../../data/site';
import { breadcrumbs, graph } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }];
const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const schema = graph(breadcrumbs(crumbs), { '@type': 'DefinedTermSet', name: 'Home Theater Glossary', hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.short, url: `${SITE.url}/glossary/${t.slug}/` })) });
---
<Base title="Home Theater Glossary: Atmos, eARC and Throw Ratio Explained" description={`${terms.length} home theater terms in plain English: Dolby Atmos, DTS:X, eARC, HDMI 2.1, throw ratio, ANSI lumens, ALR screens, room correction, crossover and more.`} schema={schema} mdAlternate="/glossary.md">
  <div class="col hub az">
    <PageHeader h1="Glossary" crumbs={crumbs} intro="The spec-sheet terms that actually change what you should buy, explained with worked examples." />
    {letters.map((l) => (
      <section>
        <h2>{l}</h2>
        <ul class="term-list">{terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => <li><a href={`/glossary/${t.slug}/`}>{t.term}</a><span>{t.short}</span></li>)}</ul>
      </section>
    ))}
  </div>
</Base>
