---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { glossary, type Term } from '../../data/glossary';
import { SITE } from '../../data/site';
import { md } from '../../lib/md';
import { breadcrumbs, graph } from '../../lib/schema';
export function getStaticPaths() { return glossary.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props as { t: Term };
const url = `/glossary/${t.slug}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }, { name: t.term, url }];
const others = glossary.filter((x) => x.slug !== t.slug);
const short = t.term.replace(/ \(.*\)$/, '');
const schema = graph({ '@type': 'DefinedTerm', name: t.term, description: t.short, url: `${SITE.url}${url}`, inDefinedTermSet: `${SITE.url}/glossary/` }, breadcrumbs(crumbs));
---
<Base title={[`What Is ${short}? Home Theater Glossary`, `What Is ${short}? Explained`, `What Is ${short}?`].find((x) => x.length <= 62)!} description={(t.short.length >= 120 ? t.short : `${short}: ${t.short} Explained with a worked example.`).slice(0, 158)} schema={schema} mdAlternate={`/glossary/${t.slug}.md`}>
  <article class="article">
    <header class="col a-head">
      <Breadcrumbs items={crumbs} />
      <div class="kicker">Glossary</div>
      <h1 class="a-title">What Is {short}?</h1>
    </header>
    <div class="col body">
      <h2 id="short-answer">{short}: The Short Answer</h2>
      <div class="answer-box"><p>{t.short}</p></div>
      <Fragment set:html={md(t.body)} />
      <h2 id="related">Related</h2>
      <ul class="link-list">{t.related.map((r) => <li><a href={r.url}>{r.title}</a></li>)}</ul>
    </div>
    <div class="col">
      <h2 class="section-title">More Terms</h2>
      <div class="chips">{others.map((o) => <a href={`/glossary/${o.slug}/`}>{o.term}</a>)}</div>
    </div>
  </article>
</Base>
