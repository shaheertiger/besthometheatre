---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import ProductImage from '../../components/ProductImage.astro';
import { products, productUrl, brandUrl, articles } from '../../lib/data';
import { CATEGORY_LABELS, SITE } from '../../data/site';
import { breadcrumbs, graph } from '../../lib/schema';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'All Gear', url: '/gear/' }];
const cats = Object.keys(CATEGORY_LABELS).filter((c) => products.some((p) => p.category === c));
const hero = (c: string) => articles.find((a) => a.kind === 'roundup' && a.hub === c);
const schema = graph(breadcrumbs(crumbs), { '@type': 'CollectionPage', name: 'Every home theater product we track', url: `${SITE.url}/gear/`, mainEntity: { '@type': 'ItemList', numberOfItems: products.length, itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${productUrl(p)}`, name: p.name })) } });
---
<Base title={`All Home Theater Gear: ${products.length} Products Rated by ${SITE.score}`} description={`Every one of the ${products.length} home theater products we track, ranked by ${SITE.score} within its category: projectors, receivers, speakers, subwoofers, soundbars and more.`} schema={schema} mdAlternate="/gear.md">
  <div class="wrap hub">
    <PageHeader h1="All Gear" crumbs={crumbs} intro={`${products.length} products, each with a spec sheet, a research-based ${SITE.score} and a verdict. Sorted by score within each category.`} />
    <nav class="chips" aria-label="Categories">{cats.map((c) => <a href={`#${c}`}>{CATEGORY_LABELS[c]}</a>)}</nav>
    {cats.map((c) => {
      const list = products.filter((p) => p.category === c);
      const h = hero(c);
      return (
        <section id={c}>
          <h2 class="section-title"><Icon icon={c} size={34} /> {CATEGORY_LABELS[c]}</h2>
          <div class="table-wrap">
            <table class="tracked">
              <thead><tr><th>#</th><th>Product</th><th>Brand</th><th>Key spec</th><th>Score</th><th>Price</th></tr></thead>
              <tbody>
                {list.map((p, i) => {
                  const k = p.keySpecs?.[0] ?? Object.keys(p.specs)[0];
                  return <tr><td>{i + 1}</td><td class="with-thumb"><ProductImage product={p} size={40} /><a href={productUrl(p)}>{p.name}</a></td><td><a href={brandUrl(p.brand)}>{p.brand}</a></td><td>{k ? `${k}: ${p.specs[k]}` : '—'}</td><td>{p.score}</td><td class="nowrap">{p.priceBand}</td></tr>;
                })}
              </tbody>
            </table>
          </div>
          {h && <p class="fine"><a href={`/${h.slug}/`}>{h.h1} →</a></p>}
        </section>
      );
    })}
  </div>
</Base>
