---
// One page per product: /gear/<slug>/. Ranks for "<model> review" and "<model> specs" searches.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductImage from '../../components/ProductImage.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import Score from '../../components/Score.astro';
import ProsCons from '../../components/ProsCons.astro';
import FAQ from '../../components/FAQ.astro';
import StickyBuyBar from '../../components/StickyBuyBar.astro';
import { AUTHOR, authorUrl } from '../../data/authors';
import { productUpdated, formatDate, products, productsByCategory, productsByBrand, articlesForProduct, productUrl, brandUrl, articleUrl, compareSlug, shortName } from '../../lib/data';
import { compares } from '../../data/compares';
import { CATEGORY_LABELS, SITE } from '../../data/site';
import { md } from '../../lib/md';
import { breadcrumbs, faqPage, graph, productSchema } from '../../lib/schema';
import { amazonImage, amazonUrl } from '../../lib/amazon';
import type { Product, FAQ as F } from '../../lib/types';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };
const catLabel = CATEGORY_LABELS[p.category] ?? p.category;
const peers = productsByCategory(p.category).filter((x) => x.slug !== p.slug);
const cheaper = peers.filter((x) => x.priceTier < p.priceTier).sort((a, b) => b.score - a.score).slice(0, 3);
const better = peers.filter((x) => x.score > p.score).sort((a, b) => a.priceTier - b.priceTier).slice(0, 3);
const [altHead, alts] = cheaper.length ? ['Cheaper options', cheaper] : better.length ? ['Higher-scoring options', better] : [`Other ${catLabel.toLowerCase()} we track`, peers.slice(0, 3)];
const sameBrand = productsByBrand(p.brand).filter((x) => x.slug !== p.slug).slice(0, 4);
const inArticles = articlesForProduct(p.slug);
const rank = productsByCategory(p.category).findIndex((x) => x.slug === p.slug) + 1;
const total = productsByCategory(p.category).length;
const myCompares = compares.filter(([a, b]) => a === p.slug || b === p.slug).map(([a, b]) => ({ slug: compareSlug(a, b), other: products.find((x) => x.slug === (a === p.slug ? b : a))! })).filter((c) => c.other);
const lc = (s: string) => s.charAt(0).toLowerCase() + s.slice(1).replace(/\.$/, '');

const autoFaqs: F[] = [
  { q: `Is the ${p.name} worth it?`, a: `${p.summary} It scores **${p.score}/100** on our ${SITE.score}, ranking #${rank} of the ${total} ${catLabel.toLowerCase()} we track. It is best for ${lc(p.bestFor)}; skip it if ${lc(p.skipIf)}.` },
  ...(cheaper[0] ? [{ q: `What is a cheaper alternative to the ${p.name}?`, a: `The [${cheaper[0].name}](${productUrl(cheaper[0])}) (${cheaper[0].priceBand}) scores ${cheaper[0].score}/100. ${cheaper[0].summary}` }] : []),
];
const faqs = [...(p.faqs ?? []), ...autoFaqs];
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'All Gear', url: '/gear/' },
  { name: catLabel, url: `/gear/#${p.category}` },
  { name: p.name, url: productUrl(p) },
];
const sn = shortName(p.name);
// enthusiastreview.com product titles: "<Model> Review: Specs, Score & Verdict", padded with the category noun when
// short, then " (NN/100)" when it still fits in 65. Aim for 50-62 characters before the score.
const noun = (CATEGORY_LABELS[p.category] ?? '').replace(/ & .*$/, '').replace(/ies$/, 'y').replace(/([^s])s$/, '$1');
const named = noun && !p.name.toLowerCase().includes(noun.split(' ').pop()!.toLowerCase()) ? `${p.name} ${noun}` : p.name;
const titleOpts = [`${p.name} Review: Specs, Score & Verdict`, `${named} Review: Specs, Score & Verdict`, `${named} Review: Specs, ${SITE.score} & Verdict`, `${p.name} Review: Specs & ${SITE.score}`, `${sn} Review: Specs, Score & Verdict`, `${sn} Review: Specs & Score`, `${sn} Review & Specs`, `${sn} Review`];
// Very long model names: cut the name at a word so "<name> Review" still fits in 62.
const cutName = p.name.length > 55 ? p.name.slice(0, p.name.lastIndexOf(' ', 55)) : p.name;
const baseTitle = titleOpts.find((t) => t.length >= 50 && t.length <= 62) ?? titleOpts.find((t) => t.length <= 62) ?? `${cutName} Review`;
const title = `${baseTitle} (${p.score}/100)`.length <= 65 ? `${baseTitle} (${p.score}/100)` : baseTitle;
// enthusiastreview.com productDescription(): "<Model> at a glance:" up to three specs (lead under 100 characters),
// then the summary, cut at a word like a SERP snippet.
const lead = `${p.name} at a glance: `;
const specBits: string[] = [];
for (const [k, v] of Object.entries(p.specs)) {
  const next = [...specBits, `${/^[A-Z][a-z]/.test(k) ? k.charAt(0).toLowerCase() + k.slice(1) : k} ${v.replace(/\s*\([^)]*\)/g, '').replace(/;.*$/, '').trim()}`];
  if ((lead + next.join(', ')).length > 100 || next.length > 3) break;
  specBits.splice(0, specBits.length, ...next);
}
const fullDesc = specBits.length ? `${lead}${specBits.join(', ')}. ${p.summary}` : p.summary;
const description = fullDesc.length <= 158 ? fullDesc : `${fullDesc.slice(0, fullDesc.lastIndexOf(' ', 157)).replace(/[\s,;:–—-]+$/, '')}…`;
const schema = graph(productSchema(p), breadcrumbs(crumbs), faqPage(faqs));
const keys = (p.keySpecs?.length ? p.keySpecs : Object.keys(p.specs)).filter((k) => p.specs[k]).slice(0, 4);
const img = amazonImage(p, 500);
const updated = productUpdated(p);
---
<Base title={title} description={description} type="article" schema={schema} preloadImage={amazonImage(p, 300) ?? undefined} ogImage={img ?? undefined} section={catLabel} published={updated} updated={updated}>
  <article class="article gear">
    <header class="col a-head">
      <Breadcrumbs items={crumbs} />
      <div class="kicker"><a href={brandUrl(p.brand)}>{p.brand}</a> · <a href={`/gear/#${p.category}`}>{catLabel}</a></div>
      <h1 class="a-title">{p.name}</h1>
      <div class="gear-meta">
        <Score score={p.score} size="lg" />
        <span>By <a href={authorUrl}>{AUTHOR.name}</a> · #{rank} of {total} {catLabel.toLowerCase()} · {p.priceBand}{p.released && <> · Released {p.released}</>} · Updated <time datetime={updated}>{formatDate(updated)}</time></span>
      </div>
    </header>

    <div class="col">
      <section class="quick-card">
        <div class="qc-hero">
          <figure class="qc-photo">
            <ProductImage product={p} size={220} buy eager />
            {img && <figcaption>Amazon listing photo</figcaption>}
          </figure>
          <div>
            <h2 class="mini">Quick answer</h2>
            <p>{p.summary}</p>
          </div>
        </div>
        <dl class="qc-fit">
          <div><dt>Best for</dt><dd>{p.bestFor}</dd></div>
          <div><dt>Skip it if</dt><dd>{p.skipIf}</dd></div>
        </dl>
        <dl class="keyspecs">{keys.map((k) => <div><dt>{k}</dt><dd>{p.specs[k]}</dd></div>)}</dl>
        <div class="pick-cta"><AmazonButton product={p} /><a class="more" href="#specs">All {sn} specs ↓</a></div>
      </section>
    </div>

    <div class="col body">
      <h2 id="specs">{p.name} Specs</h2>
      <div class="table-wrap">
        <table class="spec-table kv">
          <tbody>{Object.entries(p.specs).map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}<tr><th scope="row">Street price</th><td>{p.priceBand} (typical band; check the live price)</td></tr></tbody>
        </table>
      </div>
      <p class="fine">Specs from {p.brand}'s published spec sheet and product listings. The score comes from the spec sheet, room maths, published independent measurements and owner reports. <a href="/how-we-test/">How we score</a>.</p>

      <h2 id="score">{SITE.score}: {p.score}/100</h2>
      <p>The {SITE.score} weighs the spec sheet against the price band and what owners report over time.</p>
      {p.scores?.length && (
        <div class="bars">
          {p.scores.map((s) => (
            <div class="bar"><span class="bar-k">{s.label}</span><span class="bar-track"><span class="bar-fill" style={`width:${s.value}%`} /></span><span class="bar-v">{s.value}</span></div>
          ))}
        </div>
      )}

      <h2 id="verdict">Our Verdict</h2>
      <Fragment set:html={md(p.verdict)} />
      <ProsCons pros={p.pros} cons={p.cons} level="h3" />

      {alts.length > 0 && (
        <>
          <h2 id="alternatives">Alternatives to the {p.name}</h2>
          <h3>{altHead}</h3>
          <div class="alt-cards">
            {alts.map((x) => <a class="alt-card" href={productUrl(x)}><ProductImage product={x} size={64} /><span><strong>{x.name}</strong><small><Score score={x.score} /> · {x.priceBand}</small></span></a>)}
          </div>
        </>
      )}
      {sameBrand.length > 0 && (
        <>
          <h3>More from {p.brand}</h3>
          <div class="alt-cards">{sameBrand.map((x) => <a class="alt-card" href={productUrl(x)}><ProductImage product={x} size={64} /><span><strong>{x.name}</strong><small><Score score={x.score} /> · {x.priceBand}</small></span></a>)}</div>
        </>
      )}

      {myCompares.length > 0 && (
        <>
          <h2 id="compare">Compare the {sn}</h2>
          <ul class="link-list">{myCompares.map((c) => <li><a href={`/compare/${c.slug}/`}>{sn} vs {shortName(c.other.name)}</a></li>)}</ul>
        </>
      )}

      <h2 id="faq">{p.name} FAQ</h2>
      <FAQ faqs={faqs} />

      {inArticles.length > 0 && (
        <>
          <h2 id="featured">Featured In</h2>
          <ul class="link-list">{inArticles.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a> <span class="tag">{a.picks!.find((x) => x.product === p.slug)!.award}</span></li>)}</ul>
        </>
      )}
    </div>

    <StickyBuyBar items={[{ slug: p.slug, name: p.name, label: `${SITE.score} ${p.score}/100 · ${p.priceBand}`, url: amazonUrl(p), image: amazonImage(p, 160) }]} />
  </article>
</Base>
