---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title={`Page Not Found | ${SITE.name}`} description="The page you were looking for could not be found." noindex>
  <div class="col not-found">
    <h1 class="hub-title">Page Not Found</h1>
    <p class="hub-dek" style="margin-inline:auto">That page has moved or never existed. Try one of our most popular guides:</p>
    <div class="chips">
      <a href="/best-home-theater-systems/">Home Theater Systems</a>
      <a href="/best-projector-for-home-theater/">Projectors</a>
      <a href="/best-home-theater-speakers/">Speakers</a>
      <a href="/best-of/">All Best Lists</a>
    </div>
  </div>
</Base>
