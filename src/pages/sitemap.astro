---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { articles, products, brands, brandUrl, productUrl, articleUrl, hubLabel, productMap, compareSlug } from '../lib/data';
import { compares } from '../data/compares';
import { glossary } from '../data/glossary';
import { CATEGORY_LABELS } from '../data/site';
import { FOOTER_COMPANY } from '../data/nav';
import { breadcrumbs, graph } from '../lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Sitemap', url: '/sitemap/' }];
const roundups = articles.filter((a) => a.kind === 'roundup');
const hubOrder = [...new Set(roundups.map((a) => a.hub))];
const reviews = articles.filter((a) => a.kind === 'review');
const guides = articles.filter((a) => a.kind === 'guide');
const cats = Object.keys(CATEGORY_LABELS).filter((c) => products.some((p) => p.category === c));
const pairs = compares.filter(([a, b]) => productMap.has(a) && productMap.has(b));
const tools = [
  { title: 'Projector Throw Distance Calculator', url: '/tools/projector-throw-calculator/' },
  { title: 'Viewing Distance & Screen Size Calculator', url: '/tools/viewing-distance-calculator/' },
];
---
<Base title="Sitemap: Every Page on Best Home Theater Review" description={`Every page on Best Home Theater Review: ${roundups.length} best lists, ${reviews.length} brand reviews, ${guides.length} guides, ${products.length} product pages, ${pairs.length} comparisons, tools and glossary.`} schema={graph(breadcrumbs(crumbs))}>
  <div class="wrap hub">
  <PageHeader h1="Sitemap" crumbs={crumbs} intro={`Every page on the site, grouped by type. Search engines can use the <a href="/sitemap.xml">XML sitemap</a>.`} />
    <section>
      <h2 class="section-title"><a href="/best-of/">Best Lists</a></h2>
      <div class="grid">
        {hubOrder.map((h) => (
          <div><p class="mini">{hubLabel(h)}</p>
            <ul class="link-list">{roundups.filter((a) => a.hub === h).map((a) => <li><a href={articleUrl(a)}>{a.h1}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
    <section class="grid grid-2">
      <div><h2 class="section-title"><a href="/reviews/">Brand Reviews</a></h2>
        <ul class="link-list">{reviews.map((a) => <li><a href={articleUrl(a)}>{a.h1}</a></li>)}</ul></div>
      <div><h2 class="section-title"><a href="/guides/">Guides &amp; Tools</a></h2>
        <ul class="link-list">{[...guides.map((a) => ({ title: a.h1, url: articleUrl(a) })), ...tools].map((l) => <li><a href={l.url}>{l.title}</a></li>)}</ul></div>
    </section>
    <section>
      <h2 class="section-title"><a href="/gear/">All {products.length} Products</a></h2>
      <div class="grid">
        {cats.map((c) => (
          <div><p class="mini">{CATEGORY_LABELS[c]}</p>
            <ul class="link-list">{products.filter((p) => p.category === c).map((p) => <li><a href={productUrl(p)}>{p.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
    <section>
      <h2 class="section-title"><a href="/compare/">Comparisons</a></h2>
      <ul class="link-list">{pairs.map(([a, b]) => <li><a href={`/compare/${compareSlug(a, b)}/`}>{productMap.get(a)!.name} vs {productMap.get(b)!.name}</a></li>)}</ul>
    </section>
    <section class="grid grid-2">
      <div><h2 class="section-title"><a href="/brands/">Brands</a></h2>
        <ul class="link-list">{brands.map((b) => <li><a href={brandUrl(b)}>{b}</a></li>)}</ul></div>
      <div><h2 class="section-title"><a href="/glossary/">Glossary</a></h2>
        <ul class="link-list">{glossary.map((g) => <li><a href={`/glossary/${g.slug}/`}>{g.term}</a></li>)}</ul></div>
    </section>
    <section><h2 class="section-title">Company</h2>
      <ul class="link-list">{FOOTER_COMPANY.map((l) => <li><a href={l.url}>{l.title}</a></li>)}</ul>
    </section>
  </div>
</Base>
