---
// Root-level pages: buyer's guides (/best-home-theater-systems/), brand reviews (/bose-home-theater-review/)
// and guides (/home-theater-setup-guide/). Outline copied from enthusiastreview.com:
// H1 → dek → byline → lede → shortlist → On this page → 1. Short Answer (+ picks table) → how we ranked →
// sections → picks → specs side by side → sections → mistakes → bottom line → FAQ → sources → all we track.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Byline from '../components/Byline.astro';
import QuickPicks from '../components/QuickPicks.astro';
import PickBlock from '../components/PickBlock.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FAQ from '../components/FAQ.astro';
import TOC from '../components/TOC.astro';
import Score from '../components/Score.astro';
import AmazonButton from '../components/AmazonButton.astro';
import RelatedCards from '../components/RelatedCards.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { SITE, CATEGORY_LABELS } from '../data/site';
import { compares } from '../data/compares';
import { articles, articleMap, getProduct, productMap, hubLabel, readMinutes, articleUrl, brandUrl, productUrl, productsByBrand, productsByCategory, compareSlug, shortName, formatDate } from '../lib/data';
import { md, mdInline, slugify } from '../lib/md';
import { articleSchema, breadcrumbs, faqPage, graph, itemList } from '../lib/schema';
import { amazonImage, amazonUrl, AFFILIATE_REL } from '../lib/amazon';
import type { Article } from '../lib/types';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article: a } = Astro.props as { article: Article };
const url = articleUrl(a);
const picks = a.picks ?? [];
const pickProducts = picks.map((p) => getProduct(p.product));
const top = pickProducts[0];
const isReview = a.kind === 'review';
const isGuide = a.kind === 'guide';
const cat = CATEGORY_LABELS[a.hub] ? a.hub : top?.category;
const catLabel = cat ? CATEGORY_LABELS[cat] : hubLabel(a.hub);
const before = a.sections.filter((s) => s.position === 'before');
const after = a.sections.filter((s) => s.position !== 'before');
const subject = a.h1.replace(/^(The )?Best /, '');

// Spec table columns: keep specs most picks actually have; top up from shared key specs.
const coverage = (k: string) => pickProducts.filter((p) => p.specs[k]).length / Math.max(1, pickProducts.length);
const columns = (a.comparisonSpecs ?? []).filter((k) => coverage(k) >= 0.5);
for (const k of [...new Set(pickProducts.flatMap((p) => p.keySpecs ?? []))].sort((x, y) => coverage(y) - coverage(x))) {
  if (columns.length >= 4) break;
  if (!columns.includes(k) && coverage(k) >= 0.6) columns.push(k);
}

// Short Answer: the article's quick answer, else the first paragraph of the bottom line.
const shortAnswer = a.quickAnswer ?? a.bottomLine.split(/\n\n/)[0];
const tracked = isReview && a.brand ? productsByBrand(a.brand) : cat && !isGuide ? productsByCategory(cat) : [];
const pickSlugs = new Set(picks.map((p) => p.product));
const headToHead = compares.filter(([x, y]) => pickSlugs.has(x) && pickSlugs.has(y) && productMap.has(x) && productMap.has(y));

// Numbered H2 outline: Short Answer first (the Bing rule), then the enthusiastreview.com order.
const H = {
  short: `${a.h1.includes(':') ? a.h1.split(':')[0].trim() : a.h1}: The Short Answer`,
  how: isReview && a.brand ? `How We Ranked the ${a.brand} Lineup` : `How We Ranked These ${catLabel}`,
  picks: a.picksHeading ?? (isReview && a.brand ? `The ${a.brand} Lineup, Ranked` : `${a.h1}: Our ${picks.length} Picks`),
  specs: 'Spec Sheets Side by Side',
  mistakes: 'Common Mistakes to Avoid',
  bottom: 'The Bottom Line',
  faq: 'Frequently Asked Questions',
  sources: 'Sources and Recent Updates',
  tracked: isReview && a.brand ? `Every ${a.brand} Product We Track` : `All ${catLabel} We Track`,
};
const hasPicks = picks.length > 0;
const outline: [string, string][] = [
  ['short-answer', H.short],
  ...(hasPicks && !isGuide ? [['how-we-ranked', H.how] as [string, string]] : []),
  ...before.map((s) => [slugify(s.heading), s.heading] as [string, string]),
  ...(hasPicks ? [['picks', H.picks] as [string, string]] : []),
  ...(picks.length > 1 ? [['specs', H.specs] as [string, string]] : []),
  ...after.map((s) => [slugify(s.heading), s.heading] as [string, string]),
  ...(a.mistakes?.length ? [['mistakes', H.mistakes] as [string, string]] : []),
  ['bottom-line', H.bottom],
  ['faq', H.faq],
  ['sources', H.sources],
  ...(tracked.length ? [['tracked', H.tracked] as [string, string]] : []),
];
const num = (id: string) => `${outline.findIndex(([x]) => x === id) + 1}. `;
const toc = outline.map(([id, label]) => ({ id, label }));

const related = a.related.map((s) => articleMap.get(s)).filter(Boolean) as Article[];
const sameHub = articles.filter((x) => x.hub === a.hub && x.slug !== a.slug && !related.includes(x));
const shownRelated = [...related, ...sameHub].slice(0, 6);
const moreInHub = sameHub.filter((x) => !shownRelated.includes(x));
const crumbs = [
  { name: 'Home', url: '/' },
  isReview ? { name: 'Brand Reviews', url: '/reviews/' } : isGuide ? { name: 'Guides', url: '/guides/' } : { name: 'Best Lists', url: '/best-of/' },
  { name: a.h1, url },
];
const kicker = isReview && a.brand ? `${a.brand} · Brand Review` : isGuide ? 'Guide' : catLabel;
const firstImg = top ? amazonImage(top, 500) ?? undefined : undefined;
const schema = graph(
  articleSchema(a, url, firstImg),
  breadcrumbs(crumbs),
  ...(hasPicks ? [itemList(pickProducts.map((p) => ({ name: p.name, url: productUrl(p), product: p })), a.h1)] : []),
  faqPage(a.faqs),
);
const sources = [
  ...pickProducts.map((p) => `${p.brand} spec sheet and product listing for the [${p.name}](${productUrl(p)})`),
  'Published independent measurements and owner reports, cross-checked against the manufacturer figures',
  `Our [${SITE.score} method](/how-we-test/) and room maths ([throw](/tools/projector-throw-calculator/) and [viewing distance](/tools/viewing-distance-calculator/) calculators)`,
];
---
<Base title={a.title} description={a.metaDescription} type="article" schema={schema} published={a.published} updated={a.updated} section={catLabel} tags={a.keywords.slice(0, 5)} mdAlternate={`/${a.slug}.md`} preloadImage={top ? amazonImage(top, 160) ?? undefined : undefined} ogImage={firstImg}>
  <article class="article">
    <header class="a-head col">
      <Breadcrumbs items={crumbs} />
      <div class="kicker">{kicker}</div>
      <h1 class="a-title">{a.h1}</h1>
      <p class="dek">{a.metaDescription}</p>
      <Byline updated={a.updated} published={a.published} minutes={readMinutes(a)} disclosure={hasPicks} />
    </header>

    <div class="col body lede" set:html={md(a.intro)} />

    <div class="col">
      {hasPicks && <QuickPicks picks={picks} />}
      <TOC items={toc} />
    </div>

    <div class="col body">
      <h2 id="short-answer">{num('short-answer')}{H.short}</h2>
      <div class="answer-box" set:html={md(shortAnswer)} />
      {hasPicks && (
        <div class="table-wrap">
          <table class="picks-table">
            <caption>{a.h1}: picks compared</caption>
            <thead><tr><th>Pick</th><th>Best for</th><th>Skip it if</th><th>Score</th><th>Price</th></tr></thead>
            <tbody>
              {picks.map((pk, i) => {
                const p = pickProducts[i];
                return (
                  <tr>
                    <td><span class="tag">{pk.award}</span><a href={`#pick-${i + 1}`}>{p.name}</a></td>
                    <td>{p.bestFor}</td>
                    <td>{p.skipIf}</td>
                    <td><Score score={p.score} /></td>
                    <td class="nowrap">{p.priceBand}<br /><a class="cell-link" href={productUrl(p)}>Specs</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {hasPicks && !isGuide && (
        <>
          <h2 id="how-we-ranked">{num('how-we-ranked')}{H.how}</h2>
          <p>Every product on this page has a full spec sheet and a {SITE.score} out of 100. We ranked {isReview && a.brand ? `${a.brand}'s lineup` : `these ${catLabel.toLowerCase()}`} on four things, weighted by what changes the result in a real room:</p>
          <ul class="criteria">
            <li><strong>The spec sheet, read properly.</strong> Power at all channels driven, ISO lumens, response at ±3 dB: the conditions behind the headline number.</li>
            <li><strong>Room fit.</strong> Room size, seating distance, ambient light and placement, converted into throw distance, headroom and bass output.</li>
            <li><strong>Value for the price band.</strong> A great budget model can outrank an expensive mediocre one.</li>
            <li><strong>Owner-reported reliability.</strong> Recurring failures, firmware problems and support issues over months of use.</li>
          </ul>
          {tracked.length > 0 && <p class="fine">We track {tracked.length} {isReview && a.brand ? `${a.brand} products` : catLabel.toLowerCase()}; {picks.length} made this list. Scores are research scores, not lab results. <a href="/how-we-test/">How the {SITE.score} works</a>.</p>}
        </>
      )}

      {before.map((s) => (<><h2 id={slugify(s.heading)}>{num(slugify(s.heading))}{s.heading}</h2><Fragment set:html={md(s.body)} /></>))}
      {hasPicks && <h2 id="picks">{num('picks')}{H.picks}</h2>}
    </div>

    {hasPicks && <div class="col">{picks.map((pk, i) => <PickBlock pick={pk} index={i + 1} />)}</div>}

    <div class="col body">
      {picks.length > 1 && (
        <>
          <h2 id="specs">{num('specs')}{H.specs}</h2>
          <ComparisonTable products={pickProducts} specs={columns} />
        </>
      )}

      {after.map((s) => (<><h2 id={slugify(s.heading)}>{num(slugify(s.heading))}{s.heading}</h2><Fragment set:html={md(s.body)} /></>))}

      {a.mistakes?.length && (
        <>
          <h2 id="mistakes">{num('mistakes')}{H.mistakes}</h2>
          {a.mistakes.map((m) => (<><h3>{m.title}</h3><Fragment set:html={md(m.body)} /></>))}
        </>
      )}

      <h2 id="bottom-line">{num('bottom-line')}{H.bottom}</h2>
      <Fragment set:html={md(a.bottomLine)} />
      {top && <p><AmazonButton product={top} label={`Check the ${shortName(top.name)} on Amazon`} /></p>}

      <h2 id="faq">{num('faq')}{H.faq}</h2>
      <FAQ faqs={a.faqs} />

      <h2 id="sources">{num('sources')}{H.sources}</h2>
      <h3>Recent updates</h3>
      <ul><li><time datetime={a.updated}>{formatDate(a.updated)}</time>: {hasPicks ? 'picks, prices and specs rechecked.' : 'advice and links rechecked.'}</li></ul>
      <h3>What this page is based on</h3>
      <ul>{(hasPicks ? sources : sources.slice(-2)).map((s) => <li set:html={mdInline(s)} />)}</ul>
      <p class="fine">Spotted a spec that changed or a product that went out of stock? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>

      {tracked.length > 0 && (
        <>
          <h2 id="tracked">{num('tracked')}{H.tracked}</h2>
          <div class="table-wrap">
            <table class="tracked">
              <thead><tr><th>Product</th><th>{isReview ? 'Category' : 'Brand'}</th><th>Score</th><th>Price</th><th></th></tr></thead>
              <tbody>
                {tracked.map((p) => (
                  <tr class={pickSlugs.has(p.slug) ? 'is-pick' : undefined}>
                    <td><a href={productUrl(p)}>{p.name}</a>{pickSlugs.has(p.slug) && <span class="tag">On this list</span>}</td>
                    <td>{isReview ? CATEGORY_LABELS[p.category] : <a href={brandUrl(p.brand)}>{p.brand}</a>}</td>
                    <td>{p.score}</td>
                    <td class="nowrap">{p.priceBand}</td>
                    <td><a href={amazonUrl(p)} rel={AFFILIATE_REL} target="_blank">Price</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {isReview && a.brand && <p class="fine">Spec sheets and scores for every model: <a href={brandUrl(a.brand)}>{a.brand} brand page</a>.</p>}
        </>
      )}

      {headToHead.length > 0 && (
        <>
          <h2 class="plain" id="head-to-head">Head-to-Head Comparisons</h2>
          <ul class="link-list">{headToHead.map(([x, y]) => <li><a href={`/compare/${compareSlug(x, y)}/`}>{shortName(productMap.get(x)!.name)} vs {shortName(productMap.get(y)!.name)}</a></li>)}</ul>
        </>
      )}
    </div>

    {shownRelated.length > 0 && (
      <aside class="wrap related">
        <h2 class="section-title">Related Guides</h2>
        <RelatedCards articles={shownRelated} />
        {moreInHub.length > 0 && (
          <div class="more-in">
            <p class="mini">More in {hubLabel(a.hub)}</p>
            <div class="chips">
              {moreInHub.map((r) => <a href={articleUrl(r)}>{r.h1}</a>)}
              {cat && !isGuide && <a href={`/gear/#${cat}`}>All {catLabel.toLowerCase()} we track</a>}
            </div>
          </div>
        )}
      </aside>
    )}

    {top && <StickyBuyBar items={[{ slug: top.slug, name: top.name, label: `${picks[0].award} · ${SITE.score} ${top.score}/100 · ${top.priceBand}`, url: amazonUrl(top), image: amazonImage(top, 160) }]} />}
  </article>
</Base>
